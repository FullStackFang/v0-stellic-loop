# Postgres connection for the app: the transaction pooler (port 6543), Supabase → Connect → Transaction pooler.
# On Vercel it can stay unset: the Supabase integration injects POSTGRES_URL, which the app falls back to.
DATABASE_URL=
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
# Bearer secret Vercel Cron sends to /api/cron/daily and /api/cron/emba-documents
CRON_SECRET=
# Public origin, no trailing slash, e.g. https://quorum-board.vercel.app
NEXT_PUBLIC_APP_URL=
# Server-only key for trip text and document extraction. Vercel deployments can use VERCEL_OIDC_TOKEN.
AI_GATEWAY_API_KEY=

# Optional EMBA MCP/API; unset values keep remote ingress disabled.
# Set clerk after provisioning the managed login instance; other/unset uses JWT verification.
LOOP_AUTH_PROVIDER=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_TELEMETRY_DISABLED=1
# Provider-issued JWTs must have matching issuer/audience and an allowlisted client_id.
LOOP_AUTH_ISSUER=
LOOP_AUTH_AUDIENCE=
LOOP_AUTH_JWKS_URL=
LOOP_AUTH_CLIENT_IDS=
# Only for explicit-credential local stdio; never expose in browser configuration.
LOOP_ACCESS_TOKEN=
# Server-only JSON array of exact orgId/loopId/keyId and Ed25519 PKCS8 privateKey.
# Configure as a Vercel Secret, separately per environment. Never NEXT_PUBLIC_.
# See docs/emba-signing-custody.md. Unset or invalid configuration disables signing.
LOOP_ANNOUNCEMENT_KEYS=
# Opt-in document/query embeddings via Gateway. Requires optional pgvector migration.
# Source passages and queries leave the app; see docs/emba-embeddings.md.
LOOP_EMBEDDINGS_ENABLED=false

# --- local only: database tests against board-test (never board-dev) ---
# board-test's session pooler or direct connection (port 5432); reset by `npm run test:db`
SUPABASE_TEST_DB_URL=
# board-test's API URL and publishable (anon) key, used only to prove the public key reads nothing
SUPABASE_TEST_URL=
SUPABASE_TEST_PUBLISHABLE_KEY=
