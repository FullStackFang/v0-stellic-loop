# Postgres connection for the app: the transaction pooler (port 6543), Supabase → Connect → Transaction pooler.
# On Vercel it can stay unset: the Supabase integration injects POSTGRES_URL, which the app falls back to.
DATABASE_URL=
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
# Bearer secret Vercel Cron sends to /api/cron/daily
CRON_SECRET=
# Public origin, no trailing slash, e.g. https://quorum-board.vercel.app
NEXT_PUBLIC_APP_URL=

# --- local only: database tests against board-test (never board-dev) ---
# board-test's session pooler or direct connection (port 5432); reset by `npm run test:db`
SUPABASE_TEST_DB_URL=
# board-test's API URL and publishable (anon) key, used only to prove the public key reads nothing
SUPABASE_TEST_URL=
SUPABASE_TEST_PUBLISHABLE_KEY=
