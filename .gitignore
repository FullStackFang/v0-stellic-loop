# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

!.env.example

# local only
index.pre-pulse-ds.html
.playwright-mcp/
/supabase/.temp/

# Design mockups stay on the founder's machine (localhost:3000/demo) and off GitHub and the live site,
# except the two the app shows inside its own pages (/c/ink, /organizers).
public/demo/mockups-*.html
!public/demo/mockups-premium.html
!public/demo/mockups-imprint.html
