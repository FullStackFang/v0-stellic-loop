# Supabase `loop-dev` project: dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase `loop-dev`: Project Settings -> API -> anon public key (browser-safe, RLS applies; no grants in this app)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase `loop-dev`: Project Settings -> API -> service_role key (server only: public page reads, cron, formation, email; bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=
# Supabase `loop-test` project: Project Settings -> Database -> Connection string (direct). Used ONLY by `npm run test:db`, which resets it. Never point this at loop-dev.
SUPABASE_TEST_DB_URL=
# Resend dashboard -> API Keys (also the SMTP password for Supabase Auth custom SMTP on loop-dev)
RESEND_API_KEY=
# Sender for app email, on a domain verified in Resend, e.g. "Loop <loop@yourdomain.edu>"
EMAIL_FROM=
# Comma-separated emails allowed to create loops (organizers), e.g. "you@cornell.edu,ra@cornell.edu"
ORGANIZER_EMAILS=
# Generate yourself (e.g. `openssl rand -hex 32`); Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=
# Generate yourself (e.g. `openssl rand -hex 32`); signs the one-tap In/Out links in reminder emails
REMINDER_LINK_SECRET=
# Public origin of this deployment, used in magic-link redirects and email links (http://localhost:3000 locally)
NEXT_PUBLIC_APP_URL=http://localhost:3000
